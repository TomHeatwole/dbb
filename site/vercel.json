{
  "functions": {
    "api/chat.mjs": {
      "includeFiles": "lib/mcp/**,public/data/players.txt,public/data/ktc_values.csv,public/data/fantasycalc.csv,public/data/ffb.csv,public/data/score_format.json,public/data/hwang_adjusted_positional_adp.csv,public/data/true_rookie_pick_chart.json,public/data/ktc_redraft_value_index.csv,public/data/stats_player_reg_*.csv,public/data/chinese_characters_prompt.txt,public/data/chinese_characters_input.txt",
      "maxDuration": 120
    },
    "api/search.mjs": {
      "maxDuration": 30
    },
    "api/fanduel-sop.mjs": {
      "maxDuration": 30
    },
    "api/ncaaf-drives.mjs": {
      "maxDuration": 30
    },
    "api/rawarb.mjs": {
      "maxDuration": 30,
      "includeFiles": "src/rawarb/**,src/corners/arbChecker.js,src/sop/sopModel.js"
    },
    "api/pl-corners.mjs": {
      "maxDuration": 30
    },
    "api/draftkings-goal-method.mjs": {
      "maxDuration": 30,
      "includeFiles": "lib/named-export.mjs,src/sop/sopModel.js,src/sop/fixtureKey.js,lib/dk-corners.mjs"
    },
    "api/kalshi-sop.mjs": {
      "maxDuration": 30,
      "includeFiles": "lib/named-export.mjs,src/sop/sopModel.js,lib/kalshi-corners.mjs"
    },
    "api/render.js": {
      "includeFiles": "api/_spa-template.html,routeMeta.json"
    }
  },
  "rewrites": [
    { "source": "/sop-static.txt", "destination": "/api/fanduel-sop?format=static" },
    { "source": "/SOP-static.txt", "destination": "/api/fanduel-sop?format=static" },
    { "source": "/api/mls-corners", "destination": "/api/pl-corners?league=mls" },
    { "source": "/api/me", "destination": "/api/auth" },
    { "source": "/api/onboard", "destination": "/api/auth" }
  ],
  "headers": [
    {
      "source": "/sop-static.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=12" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=12" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=12" }
      ]
    },
    {
      "source": "/SOP-static.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=12" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=12" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=12" }
      ]
    }
  ]
}
