# Copy this file to .env and fill in values.
# The easiest approach: paste the same REACT_APP_SITE_SETTINGS value from site/.env.local
REACT_APP_SITE_SETTINGS='{"LEAGUE_ID":"...","PREVIOUS_YEARS":{"2024":"...","2025":"..."},"STARTER_POSITION_NAMES":["QB1","RB1","RB2","RB3","WR1","WR2","WR3","TE1","FLEX1","FLEX2","SUPER"],"SEASON_START_DAY":"09/04"}'

# Public URL of the deployed site (used for deep links)
SITE_BASE_URL=https://your-site-url.com

# Optional: override path to the site's public data directory
# Defaults to ../site/public/data relative to the mcp/ folder
# DATA_DIR=/absolute/path/to/site/public/data
